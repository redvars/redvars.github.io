---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="container">
    <img src="/logo.webp" alt="" width="96" height="96" />
    <h1>Page not found</h1>
    <p>This page does not exist, or it has moved.</p>
    <wc-button href="/">Go to the home page</wc-button>
  </section>
</Base>

<style>
  section {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: var(--spacing-1000);
    text-align: center;
  }

  img {
    border-radius: var(--shape-corner-large);
  }

  h1 {
    margin: var(--spacing-300) 0 0;
    font-size: var(--typography-headline-large-font-size);
  }

  p {
    margin: var(--spacing-100) 0 var(--spacing-400);
    color: var(--color-on-surface-variant);
  }
</style>
